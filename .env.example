# --- Model provider (set exactly one before running scripts/setup-trueforge.mjs) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- TrueForge ---
TRUEFORGE_BASE_URL=http://localhost:8790

# --- incident-mcp ---
# PORT=8791
# Optional bearer token protecting the /mcp endpoint; setup script forwards it
# to the TrueForge connector as header auth.
# MCP_AUTH_TOKEN=

# --- Skill (git-backed; set after pushing this repo to a public GitHub repo) ---
# SKILL_REPO_URL=https://github.com/<you>/<repo>
# SKILL_REPO_REF=main

# --- Sandbox ---
# Optional: setup script configures Daytona automatically when this is set.
# On Linux/macOS with bwrap+socat+rg installed, TrueForge's local sandbox
# fallback works with no key at all. Never commit a real key anywhere.
# DAYTONA_API_KEY=
